# Copie para .env.local e preencha. NUNCA versione o .env.local (ver .gitignore).
# Placeholders genéricos — substitua pelos serviços do SEU projeto.

# Banco de dados
DATABASE_URL=

# Provedor de autenticação (ex.: as chaves do seu IdP)
# AUTH_ISSUER=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_SESSION_SECRET=

# Modo de manutenção (gate opcional de app): on | off
MAINTENANCE_MODE=off
