{
  "title": "AI Observabilidade - consumo de tokens e custo",
  "uid": "ai-consumo",
  "schemaVersion": 39,
  "tags": ["ai-observabilidade"],
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus" },
      { "name": "DS_LOKI", "type": "datasource", "query": "loki" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Custo (janela móvel de 30 dias) x teto - total",
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum(increase(claude_code_cost_usage_USD_total[30d]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 320 },
              { "color": "red", "value": 400 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Custo (30 dias) por projeto",
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (projeto) (increase(claude_code_cost_usage_USD_total[30d]))",
          "legendFormat": "{{projeto}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens por modelo e tipo",
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, type) (increase(claude_code_token_usage_tokens_total[1d]))",
          "legendFormat": "{{model}} / {{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Custo por origem e por dia",
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origem) (increase(claude_code_cost_usage_USD_total[1d]))",
          "legendFormat": "{{origem}}"
        }
      ],
      "interval": "1d"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sessões (Loki)",
      "datasource": { "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"user_prompt\" [30d])))"
        }
      ]
    }
  ]
}
